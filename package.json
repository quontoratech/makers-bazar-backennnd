{
  "name": "makers-bazar-backend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "npm --workspace @marketplace/api run dev",
    "dev:worker": "npm --workspace @marketplace/api run dev:worker",
    "build": "npm --workspace @marketplace/api run build",
    "start": "npm --workspace @marketplace/api run start:all",
    "start:api": "npm --workspace @marketplace/api run start",
    "start:worker": "node apps/api/dist/worker.js",
    "typecheck": "npm --workspace @marketplace/api run typecheck"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "20.19.43",
    "better-sqlite3": "^12.6.2",
    "typescript": "5.8.2"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ]
}
