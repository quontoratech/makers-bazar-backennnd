APP_ENV=production
API_PORT=3000
API_PUBLIC_URL=https://api.example.com
WEB_ORIGIN=https://www.example.com,https://example.com
AUTH_REQUIRE_VERIFICATION=true

# Production database
DB=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=makers_bazar
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=makers_bazar
DB_SCHEMA=public

# SQLite is supported for single-instance Hostinger deployments. Keep the live
# database outside the deployment directory so application updates cannot replace it.
# DB=sqlite
# DB_PATH=/home/account/domains/api.example.com/.private/data/marketplace.sqlite
# DB_SEED_PATH=apps/api/seed/marketplace.sqlite.enc
# DB_SEED_KEY=base64-encoded-32-byte-key

# Authentication and administration
SUPERADMIN_USERNAME=replace-with-a-private-admin-username
SUPERADMIN_PASSWORD=replace-with-a-long-random-password
COOKIE_SECRET=replace-with-a-long-random-secret

# Real-time chat and protected files
CHAT_SOCKET_SECRET=replace-with-a-long-random-secret
ASSET_UPLOAD_DIR=/var/lib/makers-bazar/assets
ASSET_SEED_DIR=apps/api/seed/assets
CHAT_ATTACHMENT_DIR=/var/lib/makers-bazar/private/chat
PRIVATE_DIGITAL_ASSET_DIR=/var/lib/makers-bazar/private/digital-assets
VENDOR_ONBOARDING_DIR=/var/lib/makers-bazar/private/vendor-onboarding
VENDOR_ONBOARDING_DOWNLOAD_SECRET=replace-with-a-long-random-secret
VENDOR_ONBOARDING_REQUIRE_SCAN=true
VENDOR_ONBOARDING_SCAN_COMMAND=/usr/bin/clamscan

# Marketplace policies
MARKETPLACE_RETURN_WINDOW_DAYS=14
CART_RESERVATION_TIMEOUT_MINUTES=15
CHECKOUT_RESERVATION_TIMEOUT_MINUTES=15
DIGITAL_DOWNLOAD_GRANT_TTL_SECONDS=86400
CUSTOMER_DATA_RETENTION_DAYS=2555

# Cloudinary asset storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=makers-bazar

# Email
EMAIL_FROM="The Makers Bazar <noreply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional Stripe promotion payments
PROMOTION_STRIPE_SECRET_KEY=
PROMOTION_STRIPE_WEBHOOK_SECRET=
