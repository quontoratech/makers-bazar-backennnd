{{> header title="Verify your Makers Bazar account" }}

<mj-section background-color="#fafafa">
    <mj-column>
        <mj-text color="#263730" font-size="18px">Hello {{ firstName }},</mj-text>
        <mj-text color="#52635c">
            Enter this one-time code to verify your customer account. It expires in 10 minutes.
        </mj-text>
        <mj-text align="center" color="#173d34" font-size="34px" font-weight="700" letter-spacing="8px">
            {{ code }}
        </mj-text>
        <mj-text color="#718079" font-size="13px">
            Do not share this code. The Makers Bazar support will never ask for it.
        </mj-text>
    </mj-column>
</mj-section>

{{> footer }}
