{
  "name": "@marketplace/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "APP_ENV=dev ts-node -r dotenv/config ./src/index.ts",
    "dev:worker": "APP_ENV=dev ts-node -r dotenv/config ./src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/index.js",
    "start:all": "node ./dist/production.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:catalog": "ts-node -r dotenv/config ./src/scripts/verify-dynamic-catalog.ts",
    "verify:catalog-migrations": "ts-node -r dotenv/config ./src/scripts/verify-catalog-migrations.ts",
    "verify:catalog-capacity": "ts-node -r dotenv/config ./src/scripts/verify-catalog-capacity.ts",
    "verify:booking-lifecycle": "ts-node -r dotenv/config ./src/scripts/verify-booking-lifecycle.ts",
    "verify:review-rewards": "ts-node -r dotenv/config ./src/scripts/verify-review-rewards.ts",
    "verify:purchase-rewards": "ts-node -r dotenv/config ./src/scripts/verify-purchase-rewards.ts",
    "verify:reward-redemption": "ts-node -r dotenv/config ./src/scripts/verify-reward-redemption.ts",
    "verify:customer-refunds": "ts-node -r dotenv/config ./src/scripts/verify-customer-refunds.ts",
    "verify:return-disputes": "ts-node -r dotenv/config ./src/scripts/verify-return-disputes.ts",
    "verify:order-chat": "ts-node -r dotenv/config ./src/scripts/verify-order-chat.ts",
    "verify:vendor-category-requests": "ts-node -r dotenv/config ./src/scripts/verify-vendor-category-requests.ts",
    "verify:vendor-finance-consistency": "ts-node -r dotenv/config ./src/scripts/verify-vendor-finance-consistency.ts",
    "verify:direct-payments": "ts-node -r dotenv/config ./src/scripts/verify-direct-payments.ts",
    "verify:coupons": "ts-node -r dotenv/config ./src/scripts/verify-coupons.ts",
    "verify:coupons:api": "ts-node -r dotenv/config ./src/scripts/verify-coupons-api.ts",
    "verify:promotions": "ts-node -r dotenv/config ./src/scripts/verify-promotions.ts",
    "verify:promotions:api": "ts-node -r dotenv/config ./src/scripts/verify-promotions-api.ts",
    "verify:promotion-payments": "ts-node -r dotenv/config ./src/scripts/verify-promotion-payments.ts"
  },
  "dependencies": {
    "@marketplace/contracts": "0.1.0",
    "@nestjs/common": "^11.0.12",
    "@nestjs/graphql": "~13.1.0",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/websockets": "11.1.28",
    "@vendure/asset-server-plugin": "3.7.2",
    "@vendure/common": "3.7.2",
    "@vendure/core": "3.7.2",
    "@vendure/dashboard": "3.7.2",
    "@vendure/email-plugin": "3.7.2",
    "@vendure/graphiql-plugin": "3.7.2",
    "better-sqlite3": "^12.6.2",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "graphql": "^16.11.0",
    "graphql-tag": "^2.12.6",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "4.8.3",
    "stripe": "^22.6.2",
    "typeorm": "^0.3.21"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.0",
    "ts-node": "^10.9.2",
    "typescript": "5.8.2"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ]
}
